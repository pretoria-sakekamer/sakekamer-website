---
import JoinSteps from '../sections/JoinSteps.astro';
import { MembershipTiers } from '../islands/MembershipTiers';
import { Calculator } from '../islands/Calculator';
import { Faq } from '../islands/Faq';
import { localizePath, type Locale } from '../../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<MembershipTiers client:load />
<Calculator client:idle joinHref={localizePath('/lidmaatskap', lang) + '#vlakke'} />
<section class="bg-paper py-96">
  <div class="wrap faq__wrap">
    <h2 class="h-m">Vrae wat lede vra</h2>
    <Faq client:idle />
  </div>
</section>
<JoinSteps lang={lang} />
